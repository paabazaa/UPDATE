{
  "name": "surgiciss-website",
  "version": "1.1.0",
  "private": true,
  "description": "Website and account API for SURGICISS LTD: sterile instrument systems, software, services, quotes and enquiries.",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "serve": "node scripts/serve-static.mjs dist",
    "api": "node server/index.js",
    "api:dev": "node --env-file=.env server/index.js",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:migrate:dev": "node --env-file=.env scripts/migrate-db.mjs",
    "test": "node --test server/test/api.test.mjs server/test/migrations.test.mjs server/test/security.test.mjs test/content.test.mjs",
    "start": "npm run build && node server/index.js",
    "test:pages": "node --test test/pages.test.mjs",
    "lint": "eslint server scripts test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "mysql2": "^3.11.0",
    "nodemailer": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "vite": "^5.4.8"
  },
  "overrides": {
    "rollup": "4.24.0"
  }
}
