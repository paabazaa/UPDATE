# Copy to .env and fill in. Never commit .env or share these values.
# These settings are for the API in server/. The website itself needs no secrets.

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=surgiciss
DB_PASSWORD=change-me
DB_NAME=surgiciss
# The connection to the database is always encrypted and the provider certificate is always checked (see DB_SSL_CA_FILE).
DB_SSL=true

# --- API ---
PORT=3000
NODE_ENV=production
# Website addresses allowed to call the API, comma separated, no trailing slash.
# Example for GitHub Pages: https://paabazaa.github.io
ALLOWED_ORIGINS=https://example.com
# Public address of the website (including any folder), used in password-reset emails.
SITE_URL=https://example.com
# true when the API sits behind a proxy or host that sets X-Forwarded-For (most hosts).
TRUST_PROXY=true

# --- Login cookie ---
# Secure cookies need HTTPS. Use false only for local testing over http://localhost.
COOKIE_SECURE=true
# Lax (the default) keeps the login cookie off requests from other websites. Use None only when the website and API are on different domains (needs HTTPS).
COOKIE_SAMESITE=Lax
SESSION_DAYS=14

# --- Email: password resets, and a note to the business for every new quote or enquiry ---
# The sender address. With Brevo it must be an address you have verified in Brevo.
MAIL_FROM=SURGICISS LTD <surgiciss@gmail.com>
# Where new quote requests and enquiries are announced (default: surgiciss@gmail.com).
NOTIFY_EMAIL=surgiciss@gmail.com
# Choose ONE way to send. Hosts such as Render's free plan block SMTP, so use Brevo or Resend there.
# 1) Brevo (https://www.brevo.com): any recipient from one verified sender address, no domain needed.
BREVO_API_KEY=
# 2) Resend (https://resend.com): needs a verified domain to email anyone other than your own account address.
RESEND_API_KEY=
# 3) SMTP, on hosts that allow it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Sign in with Google / Facebook (optional) ---
# API_URL is the public address of this API. It is used to build the return addresses you register with Google and Facebook.
API_URL=https://api.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=v23.0
