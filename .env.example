# Copy to .env and fill in. Never commit .env or share these values.
# These settings are for the API in server/. The website itself needs no secrets.

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=surgiciss
DB_PASSWORD=change-me
DB_NAME=surgiciss
# Set to true if your database provider requires an encrypted connection.
DB_SSL=false

# --- API ---
PORT=3000
NODE_ENV=production
# Website addresses allowed to call the API, comma separated, no trailing slash.
# Example for GitHub Pages: https://paabazaa.github.io
ALLOWED_ORIGINS=https://example.com
# Public address of the website (including any folder), used in password-reset emails.
SITE_URL=https://example.com
# true when the API sits behind a proxy or host that sets X-Forwarded-For (most hosts).
TRUST_PROXY=true

# --- Login cookie ---
# Secure cookies need HTTPS. Use false only for local testing over http://localhost.
COOKIE_SECURE=true
# Use None when the website and API are on different domains (needs HTTPS), Lax when they share a domain.
COOKIE_SAMESITE=None
SESSION_DAYS=14

# --- Email for password resets (optional, but forgot-password cannot send mail without it) ---
MAIL_FROM=SURGICISS LTD <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Sign in with Google / Facebook (optional) ---
# API_URL is the public address of this API. It is used to build the return addresses you register with Google and Facebook.
API_URL=https://api.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=v23.0
